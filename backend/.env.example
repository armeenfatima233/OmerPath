# Copy to .env and fill in real values. Never commit the real .env file
# (it's gitignored) and never commit real values anywhere in this repo.

# --- Database (Supabase Postgres connection string) ---
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# --- Supabase project ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service-role key. Server-side only - never send to the frontend, never log it.
SUPABASE_SECRET_KEY=
# Publishable (anon) key. Used server-side by the auth client; still not sent
# to the frontend by this backend (the frontend never talks to Supabase directly).
SUPABASE_PUBLISHABLE_KEY=

# --- Groq (AI Advisor) ---
# Required for /api/advisor/chat. Get a key at console.groq.com.
GROQ_API_KEY=

# --- Environment ---
# "development" or "production". Controls cookie Secure default and
# whether X-Forwarded-For is trusted for rate-limit bucketing.
APP_ENV=development

# --- Frontend URL (same-site custom-domain architecture) ---
# The deployed frontend origin. Used for: CORS allowlist, and the redirect_to
# target for Supabase email links (signup confirmation, password reset) -
# this exact URL must also be added to the Supabase project's "Allowed
# Redirect URLs" in the Supabase dashboard, or those email links will fail.
# Example production value: https://app.yourdomain.com
FRONTEND_URL=http://localhost:3000

# --- Cookie configuration ---
# Defaults are correct for the same-site app.<domain> + api.<domain>
# architecture and normally do not need to be overridden:
#   - AUTH_COOKIE_SECURE defaults to true when APP_ENV=production, false otherwise.
#   - AUTH_COOKIE_SAMESITE defaults to "lax", which works correctly across
#     app.<domain> <-> api.<domain> because they share the same registrable
#     domain (same "site" for SameSite purposes, even though different hosts).
#   - AUTH_COOKIE_DOMAIN should stay UNSET in this architecture: an unset
#     Domain attribute makes the cookie host-only on api.<domain>, which is
#     all that's needed (only api.<domain> ever reads it) and is more
#     restrictive/secure than broadening it to ".yourdomain.com".
# Override only if the deployment topology changes (e.g. truly separate
# frontend/backend domains, which would require AUTH_COOKIE_SAMESITE=none).
# Render's default *.onrender.com service URLs count as "truly separate" for
# this purpose: onrender.com itself is the public-suffix boundary, so
# omerpath-frontend.onrender.com and omerpath-api.onrender.com are
# cross-site even though both end in onrender.com - the browser will not
# attach a SameSite=Lax cookie to the follow-up API request. Set
# AUTH_COOKIE_SAMESITE=none there (Secure is already true via APP_ENV=production).
# Once real app.<domain>/api.<domain> custom domains are attached, remove
# this override and let it fall back to the more restrictive "lax" default.
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=
AUTH_SESSION_MAX_AGE_SECONDS=2592000

# --- Reverse proxy / load balancer ---
# Set to true only when actually deployed behind a proxy that sets
# X-Forwarded-For (defaults to true when APP_ENV=production). Trusting this
# header from direct/dev clients would let a caller spoof its own
# rate-limit bucket.
# TRUST_PROXY_HEADERS=true
