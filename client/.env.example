# Copy to .env.local and fill in the real backend URL. Never commit .env.local.

# The deployed backend API origin (same-site custom-domain architecture:
# frontend on app.<domain>, backend on api.<domain>, both HTTPS in production).
# No API keys or secrets belong here - this file is bundled into the public
# frontend build and is visible to anyone.
# Example production value: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8000
